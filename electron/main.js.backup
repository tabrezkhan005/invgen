ipcMain.handle('set-selected-printer', async (event, printerId) => {
          const driveData = JSON.parse(stdout);
          const driveList = Array.isArray(driveData) ? driveData : [driveData];

          for (const drive of driveList) {
            if (drive.DriveLetter) {
              const totalSize = drive.Size ? Math.round(drive.Size / (1024 * 1024 * 1024)) + 'GB' : 'Unknown';
              const available = drive.SizeRemaining ? Math.round(drive.SizeRemaining / (1024 * 1024 * 1024)) + 'GB' : 'Unknown';

              drives.push({
                id: `usb-${drive.DriveLetter}`,
                name: drive.FileSystemLabel || `Removable Drive (${drive.DriveLetter}:)`,
                mountPoint: `${drive.DriveLetter}:`,
                size: totalSize,
                available: available,
                status: 'mounted'
              });
            }
          }
        }
      } catch (psError) {
        console.warn('PowerShell USB drive detection failed, trying WMIC:', psError.message);

        try {
          // Fallback to WMIC
          console.log('Running WMIC USB drive detection...');
          const { stdout } = await execAsync('wmic logicaldisk where drivetype=2 get caption,description,size,freespace /format:csv', { timeout: 5000 });
          console.log('WMIC USB output:', stdout);

        const lines = stdout.split('\n').filter(line => line.trim());
        for (let i = 1; i < lines.length; i++) {
          const parts = lines[i].split(',');
          if (parts.length >= 4) {
            const [node, caption, description, size, freeSpace] = parts;

            const totalSize = size ? Math.round(parseInt(size) / (1024 * 1024 * 1024)) + 'GB' : 'Unknown';
            const available = freeSpace ? Math.round(parseInt(freeSpace) / (1024 * 1024 * 1024)) + 'GB' : 'Unknown';

            drives.push({
              id: `usb-${caption}`,
              name: description || `Removable Drive (${caption})`,
              mountPoint: caption,
              size: totalSize,
              available: available,
              status: 'mounted'
            });
          }
        }

        // Fallback: Check drive letters manually if WMIC fails
        if (drives.length === 0) {
          for (let i = 68; i <= 90; i++) { // D to Z
            const driveLetter = String.fromCharCode(i) + ':';
            try {
              const fs = require('fs').promises;
              await fs.access(driveLetter + '\\');

              // Try to get basic drive info
              drives.push({
                id: `usb-${driveLetter}`,
                name: `Removable Drive (${driveLetter})`,
                mountPoint: driveLetter,
                size: 'Unknown',
                available: 'Unknown',
                status: 'mounted'
              });
            } catch (error) {
              // Drive not accessible or doesn't exist
            }
          }
        }
      } catch (error) {
        console.warn('Windows USB drive detection failed:', error);

        // Basic fallback
        for (let i = 68; i <= 90; i++) { // D to Z
          const driveLetter = String.fromCharCode(i) + ':';
          try {
            const fs = require('fs').promises;
            await fs.access(driveLetter + '\\');
            drives.push({
              id: `usb-${driveLetter}`,
              name: `Drive (${driveLetter})`,
              mountPoint: driveLetter,
              size: 'Unknown',
              available: 'Unknown',
              status: 'mounted'
            });
          } catch (error) {
            // Drive not accessible
          }
        }
      }
    if (process.platform === 'darwin') {
      // macOS: Use system_profiler to get removable drives
      try {
        const { stdout } = await execAsync('system_profiler SPUSBDataType -json', { timeout: 5000 });
        const data = JSON.parse(stdout);

        if (data.SPUSBDataType) {
          for (const device of data.SPUSBDataType) {
            if (device._items) {
              for (const item of device._items) {
                if (item.bsd_name && item.volumes) {
                  for (const volume of item.volumes) {
                    if (volume.mount_point) {
                      drives.push({
                        id: `usb-${item.bsd_name}`,
                        name: volume.name || `USB Drive (${item.bsd_name})`,
                        mountPoint: volume.mount_point,
                        size: volume.size_info ? Math.round(volume.size_info / (1024 * 1024 * 1024)) + 'GB' : 'Unknown',
                        available: 'Unknown',
                        status: 'mounted'
                      });
                    }
                  }
                }
              }
            }
          }
        }
      } catch (error) {
        console.warn('macOS USB drive detection failed:', error);

        // Fallback to directory listing
        try {
          const fs = require('fs').promises;
          const volumes = await fs.readdir('/Volumes');

          for (const volume of volumes) {
            if (!['Macintosh HD', 'System', 'Data'].includes(volume)) {
              const mountPoint = `/Volumes/${volume}`;
              try {
                await fs.access(mountPoint);
                drives.push({
                  id: `usb-${volume}`,
                  name: volume,
                  mountPoint: mountPoint,
                  size: 'Unknown',
                  available: 'Unknown',
                  status: 'mounted'
                });
              } catch (error) {
                // Volume not accessible
              }
            }
          }
        } catch (fallbackError) {
          console.warn('macOS USB drive fallback detection failed:', fallbackError);
        }
      }
    if (process.platform === 'linux') {
      // Linux: Use lsblk to detect removable drives
      try {
        const { stdout } = await execAsync('lsblk -o NAME,MOUNTPOINT,SIZE,FSTYPE,RM,LABEL -J', { timeout: 5000 });
        const data = JSON.parse(stdout);

        for (const device of data.blockdevices) {
          if (device.rm === '1' && device.mountpoint) { // Removable and mounted
            const size = device.size || 'Unknown';
            const name = device.label || device.name || 'Removable Drive';

            drives.push({
              id: `usb-${device.name}`,
              name: `${name} (${device.name})`,
              mountPoint: device.mountpoint,
              size: size,
              available: 'Unknown', // Would need df command
              status: 'mounted'
            });
          }
        }
      } catch (error) {
        console.warn('Linux USB drive detection failed:', error);

        // Fallback to directory listing
        try {
          const fs = require('fs').promises;
          const mediaDirs = ['/media', '/mnt', '/media/user'];

          for (const dir of mediaDirs) {
            try {
              const items = await fs.readdir(dir);
              for (const item of items) {
                const mountPoint = `${dir}/${item}`;
                try {
                  await fs.access(mountPoint);
                  drives.push({
                    id: `usb-${item}`,
                    name: item,
                    mountPoint: mountPoint,
                    size: 'Unknown',
                    available: 'Unknown',
                    status: 'mounted'
                  });
                } catch (error) {
                  // Mount point not accessible
                }
              }
            } catch (error) {
              // Directory not found or not accessible
            }
          }
        } catch (fallbackError) {
          console.warn('Linux USB drive fallback detection failed:', fallbackError);
        }
      }
    }

    console.log(`Found ${drives.length} USB drives:`, drives);
    return drives;
  } catch (error) {
    console.error('Error scanning USB drives:', error);
    return [];
  }
});

